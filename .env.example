# Set both values to enable the console sign-in form.
CONSOLE_USERNAME=
CONSOLE_PASSWORD=

# Local Node listener and queue server. Docker Compose sets its own values.
# HOST=127.0.0.1
# PORT=3080
# BEANSTALKD_HOST=127.0.0.1
# BEANSTALKD_PORT=11300
# BEANSTALK_SERVERS=Local=127.0.0.1:11300,Workers=workers.internal:11300

# Unset allows direct loopback requests. Docker Compose defaults to false.
# Setting true requires console authentication.
# ALLOW_PERSONAL_SERVERS=false
# CONSOLE_SECURE_COOKIES=false

# Local Node storage paths, relative to the project root unless absolute.
# SAMPLE_STORAGE=storage.json
# SHARED_SERVERS_STORAGE=shared-servers.json

# Docker Compose host bind and published port.
# CONSOLE_BIND=127.0.0.1
# CONSOLE_PORT=3080
